<?xml version="1.0" encoding="utf-8" ?>
<winuiex:WindowEx
    x:Class="DeskBorder.Views.ProcessDesktopPlacementPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    x:Uid="ProcessDesktopPlacementPopupWindow"
    Title="새 창 자동 데스크톱 이동"
    Width="460"
    MinHeight="0"
    Closed="OnProcessDesktopPlacementPopupWindowClosed"
    IsMaximizable="False"
    IsMinimizable="False"
    IsResizable="False"
    IsShownInSwitchers="False"
    IsTitleBarVisible="False"
    IsVisibleInTray="False"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Padding="20"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="OnRootGridLoaded">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Enter" Invoked="OnSaveKeyboardAcceleratorInvoked" />
            <KeyboardAccelerator Key="Escape" Invoked="OnCancelKeyboardAcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                x:Name="TitleTextBlock"
                x:Uid="ProcessDesktopPlacementPopupWindow_TitleTextBlock"
                FontSize="20"
                FontWeight="SemiBold"
                Text="새 창 자동 데스크톱 이동"
                TextWrapping="WrapWholeWords" />
            <TextBlock
                x:Name="DescriptionTextBlock"
                x:Uid="ProcessDesktopPlacementPopupWindow_DescriptionTextBlock"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="선택한 프로세스에서 새 창이 열리면 지정한 데스크톱으로 자동 이동하도록 규칙을 등록합니다."
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,16,0,0"
            Spacing="12">
            <Border
                Padding="12"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="ProcessNameTextBlock"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="TargetDesktopTextBlock"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <ComboBox
                x:Name="LifetimeComboBox"
                x:Uid="ProcessDesktopPlacementPopupWindow_LifetimeComboBox"
                Header="규칙 수명"
                SelectedIndex="0"
                SelectionChanged="OnLifetimeComboBoxSelectionChanged">
                <ComboBoxItem
                    x:Uid="ProcessDesktopPlacementPopupWindow_PermanentComboBoxItem"
                    Content="영구 적용"
                    Tag="Permanent" />
                <ComboBoxItem
                    x:Uid="ProcessDesktopPlacementPopupWindow_UntilProcessExitComboBoxItem"
                    Content="프로세스 종료까지"
                    Tag="UntilProcessExit" />
                <ComboBoxItem
                    x:Uid="ProcessDesktopPlacementPopupWindow_TimedComboBoxItem"
                    Content="시간 제한"
                    Tag="Timed" />
            </ComboBox>

            <NumberBox
                x:Name="TargetDesktopNumberBox"
                x:Uid="ProcessDesktopPlacementPopupWindow_TargetDesktopNumberBox"
                Header="대상 데스크톱 번호"
                Minimum="1"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ValueChanged="OnTargetDesktopNumberBoxValueChanged" />

            <NumberBox
                x:Name="TimedDurationMinutesNumberBox"
                x:Uid="ProcessDesktopPlacementPopupWindow_TimedDurationMinutesNumberBox"
                Header="유지 시간 (분)"
                Maximum="1440"
                Minimum="1"
                SmallChange="5"
                SpinButtonPlacementMode="Inline"
                Visibility="Collapsed"
                Value="30" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Uid="ProcessDesktopPlacementPopupWindow_CancelButton"
                Click="OnCancelButtonClicked"
                Content="취소" />
            <Button
                x:Uid="ProcessDesktopPlacementPopupWindow_SaveButton"
                Click="OnSaveButtonClicked"
                Content="저장"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</winuiex:WindowEx>
